---
layout: base.njk
sectionStyles:
  - /assets/css/sections/article.css
---
<article class="article">
  <div class="container article__head">
    <nav class="breadcrumbs">
      <a href="/">Главная</a> <span>/</span>
      <a href="/articles/">Статьи</a>
    </nav>

    <h1>{{ title }}</h1>
    {% if subtitle %}<p class="lede">{{ subtitle }}</p>{% endif %}
  </div>

  {% if image %}
  <div class="container article__hero">
    <figure class="frame">
      <img src="{{ image }}" alt="{{ imageAlt }}" fetchpriority="high">
    </figure>
  </div>
  {% endif %}

  <div class="container article__body">
    {{ content | safe }}
  </div>

  <div class="container article__foot">
    <a class="btn btn--ghost" href="/articles/">Все статьи</a>
    <a class="btn" href="/program/">Выбрать программу</a>
  </div>
</article>
