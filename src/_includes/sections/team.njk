<section class="section section--quiet team">
  <div class="container">
    <div class="section-head">
      <h2>люди, которые доводят книги до полки</h2>
    </div>

    <div class="team__grid">
      {% for person in team %}
      <article class="member">
        <figure class="member__photo frame">
          <img src="{{ person.photo }}" alt="{{ person.name }}" loading="lazy">
        </figure>
        <h3>{{ person.name }}</h3>
        <p class="member__role">{{ person.role }}</p>
        <ul class="member__facts">
          {% for fact in person.facts %}
          <li>{{ fact }}</li>
          {% endfor %}
        </ul>
        {% if person.quote %}
        <blockquote class="member__quote">{{ person.quote }}</blockquote>
        {% endif %}
      </article>
      {% endfor %}
    </div>
  </div>
</section>
