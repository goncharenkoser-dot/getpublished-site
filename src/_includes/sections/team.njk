<section class="section section--dark team">
  <div class="container">
    <p class="label">кто ведёт</p>
    <h2>люди, которые доводят книги до полки</h2>

    <div class="team__grid">
      {% for person in team %}
      <article class="team-card">
        <img class="team-card__photo" src="{{ person.photo }}" alt="{{ person.name }}" loading="lazy">
        <div class="team-card__body">
          <h3>{{ person.name }}</h3>
          <p class="team-card__role">{{ person.role }}</p>
          <ul class="team-card__facts">
            {% for fact in person.facts %}
            <li>{{ fact }}</li>
            {% endfor %}
          </ul>
          {% if person.quote %}
          <blockquote class="team-card__quote">{{ person.quote }}</blockquote>
          {% endif %}
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>
