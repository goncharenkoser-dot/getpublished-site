<section class="section cases-preview">
  <div class="container">
    <div class="section-head">
      <div>
        <p class="eyebrow">Кейсы</p>
        <h2>Авторы, у которых получилось</h2>
      </div>
      <a class="section-head__link" href="/cases/">Все кейсы</a>
    </div>

    <div class="card-grid">
      {% for item in collections.cases %}
      <a class="entry-card" href="{{ item.url }}">
        <h3 class="entry-card__title">{{ item.data.title }}</h3>
        <p class="entry-card__excerpt">{{ item.data.excerpt or item.data.subtitle }}</p>
        <span class="entry-card__more">Читать историю</span>
      </a>
      {% endfor %}
    </div>
  </div>
</section>
