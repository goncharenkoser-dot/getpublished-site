<section class="section cases-preview">
  <div class="container">
    <div class="section-head">
      <h2>Авторы, у которых получилось</h2>
      <a class="section-head__link" href="/cases/">Все кейсы</a>
    </div>

    <ul class="case-list">
      {% for item in collections.cases | sort(false, false, "data.order") %}{% if item.data.featured %}
      <li>
        <a class="case-row" href="{{ item.url }}">
          <figure class="case-row__thumb frame">
            <img src="{{ item.data.image }}" alt="{{ item.data.imageAlt }}" loading="lazy">
          </figure>
          <div class="case-row__text">
            <h3>{{ item.data.title }}</h3>
            <p>{{ item.data.excerpt or item.data.subtitle }}</p>
            <span class="case-row__more">Читать историю</span>
          </div>
        </a>
      </li>
      {% endif %}{% endfor %}
    </ul>
  </div>
</section>
