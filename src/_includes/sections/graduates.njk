{# «Наш алгоритм уже проверили на практике сотни выпускников» — по образцу
   getpublish.org/webinar10: ровная сетка скруглённых квадратов (7 в ряд,
   последний ряд по центру) и кнопка под ней. Порядок фото — graduates.grid
   в src/_data/graduates.json, те же 34 снимка, что на странице кейсов. #}
<section class="section graduates">
  <div class="container">
    <h2 class="graduates__title">Наш алгоритм уже проверили на практике сотни выпускников</h2>
    <p class="lede graduates__lede">
      Все они в один прекрасный день поняли, что хотят <b>написать и издать книгу</b>,
      и доверились профессионалам. Вы — следующий!
    </p>

    <ul class="graduates__grid">
      {% for file in graduates.grid %}
      <li class="graduates__item">
        <img src="/assets/img/graduates/{{ file }}"
             alt="Выпускник школы со своей книгой" width="320" height="320" loading="lazy">
      </li>
      {% endfor %}
    </ul>

    <div class="graduates__acts">
      <a class="btn graduates__btn" href="/program/">
        <span>Присоединиться</span>
        <small>к успешным авторам</small>
      </a>
    </div>
  </div>
</section>
