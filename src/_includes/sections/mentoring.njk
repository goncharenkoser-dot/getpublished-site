{# «Наставничество» — с getpublish-pb.ru/mentoring. Тексты и фото со страницы-источника,
   стили в общей системе сайта. Форма заявки внизу (#mentoring-form) пока только
   валидирует поля и показывает подтверждение — см. TODO в main.js. #}

<section class="section section--quiet mentoring" id="mentoring">
  <div class="container">
    <p class="label">Наставничество</p>
    <h2>напишите и издайте книгу в 2026 году</h2>
    <p class="lede">
      Премиальный продукт по написанию и изданию вашей книги: индивидуальное
      сопровождение эксперта по алгоритму школы GetPublishED, проверенному
      сотнями изданных авторов.
    </p>
    <div class="mentoring__acts">
      <a class="btn" href="#mentoring-form">хочу к наставнику</a>
    </div>

    <div class="mentoring__who">
      <h3>Кому мы рекомендуем писать книгу в сопровождении наставника?</h3>
      <p>
        В первую очередь экспертам в любой теме, будущим авторам нехудожественной
        литературы, которые хотят быть изданными, а также выйти из тени или
        повысить свою узнаваемость.
      </p>
      <ul class="mentoring__photos">
        {% for n in [1, 2, 3, 4] %}
        <li class="frame"><img src="/assets/img/mentoring/who-{{ n }}.jpg" alt="Презентация книги выпускницы школы в Московском доме книги" width="700" height="466" loading="lazy"></li>
        {% endfor %}
      </ul>
      <p class="mentoring__caption">На фото презентация книги нашей выпускницы в Московском доме книги</p>
    </div>
  </div>
</section>

<section class="section mentoring-fit">
  <div class="container">
    <h2>формат для вас, если</h2>
    <ul class="mcards mcards--4">
      {% set fit = [
        { img: "cards-1.jpg", title: "Вам важна индивидуальная работа,", text: "чтобы не терять ни минуты и получать информацию именно для вашей ситуации" },
        { img: "cards-2.jpg", title: "Вам сложно себя организовать,", text: "свести всё к единому проекту" },
        { img: "cards-3.jpg", title: "Вам важно довести работу до конца", text: "и добиться результата в кратчайшие сроки" },
        { img: "cards-4.jpg", title: "Вам важна среда себе подобных", text: "и новые полезные знакомства" }
      ] %}
      {% for c in fit %}
      <li class="mcard">
        <figure class="mcard__media"><img src="/assets/img/mentoring/{{ c.img }}" alt="" width="700" height="466" loading="lazy"></figure>
        <h3 class="mcard__title">{{ c.title }}</h3>
        <p class="mcard__text">{{ c.text }}</p>
      </li>
      {% endfor %}
    </ul>

    <div class="steps">
      <h3 class="steps__title">«За ручку» проведём вас по готовому алгоритму из 10 шагов</h3>
      <ol class="steps__list">
        {% for s in ["Идея (мечта)", "Анализ целевой аудитории", "Синопсис", "Черновик", "Договорённость с издателем или платформой", "Готовая рукопись", "Публикация в СМИ", "Прокачка личного бренда", "Выход книги", "Продвижение бестселлера"] %}
        <li class="steps__item"><span class="steps__n">{{ loop.index }}</span><span>{{ s }}</span></li>
        {% endfor %}
      </ol>
    </div>
  </div>
</section>

