<section class="section section--muted articles-preview">
  <div class="container">
    <div class="section-head">
      <div>
        <p class="eyebrow">База знаний</p>
        <h2>Статьи для начинающих авторов</h2>
      </div>
      <a class="section-head__link" href="/articles/">Все статьи</a>
    </div>

    <div class="card-grid">
      {% for item in collections.articles %}
      <a class="entry-card" href="{{ item.url }}">
        <h3 class="entry-card__title">{{ item.data.title }}</h3>
        <p class="entry-card__excerpt">{{ item.data.excerpt or item.data.subtitle }}</p>
        <span class="entry-card__more">Читать</span>
      </a>
      {% endfor %}
    </div>
  </div>
</section>
