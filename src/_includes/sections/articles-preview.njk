<section class="section articles-preview">
  <div class="container">
    <div class="section-head">
      <h2>Статьи для начинающих авторов</h2>
      <a class="section-head__link" href="/articles/">Все статьи</a>
    </div>

    <div class="index">
      {% for item in collections.articles | sort(false, false, "data.order") %}{% if item.data.featured %}
      <a class="index__item" href="{{ item.url }}">
        <figure class="index__media frame">
          <img src="{{ item.data.image }}" alt="{{ item.data.imageAlt }}" loading="lazy">
        </figure>
        <h3>{{ item.data.title }}</h3>
        <p>{{ item.data.excerpt or item.data.subtitle }}</p>
        <span class="index__more">Читать</span>
      </a>
      {% endif %}{% endfor %}
    </div>
  </div>
</section>
