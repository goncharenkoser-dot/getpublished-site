{# «Хотите написать и издать книгу, но…» — с getpublish-pb.ru/online-kurs-hl #}
<section class="section section--quiet objections">
  <div class="container">
    <h2 class="objections__title">Хотите написать <span>и издать книгу, но…</span></h2>

    <ul class="objections__list">
      {% for text in [
        "История не складывается в цельный сюжет",
        "Персонажи выходят картонными",
        "Застреваете на середине текста",
        "Сомневаетесь, что книгу кто-то захочет читать",
        "Пугает объём и дисциплина",
        "Страшно показать рукопись редактору и издателю"
      ] %}
      <li>
        <svg viewBox="0 0 48 48" aria-hidden="true">
          <circle cx="24" cy="24" r="21" fill="none" stroke="currentColor" stroke-width="2.5"/>
          <circle cx="17" cy="19" r="2.4" fill="currentColor"/>
          <circle cx="31" cy="19" r="2.4" fill="currentColor"/>
          <path d="M15 33c2.6-3.4 5.6-5 9-5s6.4 1.6 9 5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
        </svg>
        <span>{{ text }}</span>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
