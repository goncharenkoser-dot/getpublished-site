<section class="section covers">
  <div class="container">
    <h2 class="covers__quote">Здесь не ставят оценок за то, как вы пишете</h2>
    <p class="lede">Книги выпускников школы</p>

    <ul class="covers__rail rail">
      {% for book in covers %}
      <li class="covers__item">
        <img src="/assets/img/covers/{{ book.file }}" alt="{{ book.alt }}"
             width="340" height="536" loading="lazy">
      </li>
      {% endfor %}
    </ul>
  </div>
</section>
