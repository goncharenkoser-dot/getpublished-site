<section class="section section--quiet reviews-preview">
  <div class="container">
    <div class="section-head">
      <h2>87% выпускников рекомендуют школу знакомым</h2>
      <a class="section-head__link" href="/reviews/">Все отзывы</a>
    </div>

    <div class="reviews-grid">
      {% for review in reviews.slice(0, 3) %}
      <figure class="review">
        <blockquote>{{ review.text }}</blockquote>
        <figcaption>
          {% if review.photo %}
          <img class="review__photo" src="{{ review.photo }}" alt="" width="56" height="56" loading="lazy">
          {% endif %}
          <span class="review__who">
            <span class="review__name">{{ review.name }}</span>
            <span class="review__role">{{ review.role }}</span>
          </span>
        </figcaption>
      </figure>
      {% endfor %}
    </div>
  </div>
</section>
